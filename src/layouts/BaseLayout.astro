---
interface Props {
  title: string;
  description?: string;
  /** neutral: professional shell (default). warm: playful fonts & cream (e.g. BearHugs). */
  tone?: "neutral" | "warm";
  /** Extra body classes (e.g. page-specific theme). */
  bodyClass?: string;
  /** Tab icon: single emoji (overrides warm default 💗 when tone is warm). */
  faviconEmoji?: string;
}
const { title, description = "Technical portfolio", tone = "neutral", bodyClass, faviconEmoji } =
  Astro.props;
const shellClass = tone === "warm" ? "shell-warm" : "shell-neutral";
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() ?? "";

function emojiFaviconDataUrl(emoji: string) {
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">${emoji}</text></svg>`;
  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
}

const faviconOverride = faviconEmoji?.trim();
const faviconHref =
  faviconOverride != null && faviconOverride !== ""
    ? emojiFaviconDataUrl(faviconOverride)
    : tone === "warm"
      ? emojiFaviconDataUrl("💗")
      : emojiFaviconDataUrl("\u26AA");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      tone === "warm" ? (
        <link
          href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700&display=swap"
          rel="stylesheet"
        />
      ) : (
        <link
          href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,400&display=swap"
          rel="stylesheet"
        />
      )
    }
    <slot name="head" />
    <title>{title}</title>
    {
      gaMeasurementId ? (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
          />
          <script is:inline define:vars={{ gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaMeasurementId);
          </script>
        </>
      ) : null
    }
  </head>
  <body class:list={[shellClass, bodyClass]}>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }
  body.shell-neutral {
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #fafafa;
    color: #171717;
  }
  body.shell-warm {
    font-family: Nunito, system-ui, sans-serif;
    background: #fff8f0;
    color: #3d3545;
  }
</style>
