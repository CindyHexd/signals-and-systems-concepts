---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConceptViews from "../components/ConceptViews.astro";
import { concepts, getSortedViews, type Concept } from "../data/concepts";

export function getStaticPaths() {
  return concepts.map((concept) => ({
    params: { slug: concept.slug },
    props: { concept },
  }));
}

interface Props {
  concept: Concept;
}

const { concept } = Astro.props;
const views = getSortedViews(concept);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={`${concept.title} - Signals and Systems concepts`}
  description={`Ways of understanding “${concept.title}”: math, Chinglish, and graphic.`}
  bodyClass="ss-body"
  faviconEmoji="〰️"
>
  <div class="page">
    <a class="back" href={base}>← Concepts</a>

    <header class="hero">
      <p class="eyebrow">Signals and Systems</p>
      <h1>{concept.title}</h1>
    </header>

    <ConceptViews views={views} />
  </div>
</BaseLayout>

<style is:global>
  body.ss-body.shell-neutral {
    background: linear-gradient(180deg, #fafafa 0%, #f4f4f5 55%, #ecfdf5 100%);
  }
</style>

<style>
  .page {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 3.5rem;
    color: #18181b;
  }
  .back {
    display: inline-block;
    margin-bottom: 1.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #71717a;
    text-decoration: none;
  }
  .back:hover {
    color: #18181b;
  }
  .eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #71717a;
  }
  h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.75rem, 4vw, 2.125rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
</style>
